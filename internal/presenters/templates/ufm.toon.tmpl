{{- define "main" -}}
  {{- $envelope := dict -}}
  {{- $state := dict "Envelope" $envelope "Fatal" false "Full" (eq (getValueFromConfig "toon") "full") -}}
  {{- /* Prepare every result before writing: a later error must leave the destination untouched. */ -}}
  {{- range $result := .TestResults -}}
    {{- $issues := getIssuesFromTestResult $result -}}
    {{- template "toonDiagnostics" (dict "State" $state "Result" $result "Issues" $issues) -}}
    {{- $mappedIssues := array -}}
    {{- range $issue := reverse (sortAndFilterIssues $issues false) -}}
      {{- $mappedIssues = append $mappedIssues $issue -}}
    {{- end -}}
    {{- if eq (getValueFromConfig "include-ignores") "true" -}}
      {{- range $issue := reverse (sortAndFilterIssues $issues true) -}}
        {{- $mappedIssues = append $mappedIssues $issue -}}
      {{- end -}}
    {{- end -}}
    {{- range $issue := $mappedIssues -}}
      {{- $mapped := mapTOONIssue $issue $state.Full -}}
      {{- range $row := $mapped.Rows -}}
        {{- $_ := set $envelope $mapped.Section (append (or (index $envelope $mapped.Section) (array)) $row) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if .TestResults -}}{{- template "toonContextFields" $state -}}{{- end -}}
  {{- template "toonDocument" $envelope -}}
{{- end -}}

{{- define "toonContextFields" -}}
  {{- $envelope := .Envelope -}}
  {{- $_ := set $envelope "org" (or (getStringFromConfig "internal_org_slug") (getStringFromConfig "org") "unknown") -}}
  {{- $project := "unknown" -}}
  {{- with getStringFromConfig "targetDirectory" -}}{{- $project = baseName . -}}{{- end -}}
  {{- $_ := set $envelope "project" $project -}}
  {{- with getInteractionID -}}{{- $_ := set $envelope "interaction_id" . -}}{{- end -}}
  {{- if and (not .Full) (not .Fatal) -}}{{- $_ := set $envelope "hint" "add --toon=full for all fields" -}}{{- end -}}
  {{- with getErrorTip -}}
    {{- $tip := . -}}
    {{- if $envelope.errors -}}{{- $_ := set $envelope "hint" $tip -}}{{- end -}}
    {{- range $scanner := array "sca" "secrets" -}}
      {{- if index $envelope (print $scanner "_error") -}}
        {{- $key := print $scanner "_hint" -}}
        {{- $message := $tip -}}
        {{- with index $envelope $key -}}{{- $message = trimSpace (print . "\n" $tip) -}}{{- end -}}
        {{- $_ := set $envelope $key $message -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- define "toonDiagnosticMessage" -}}
  {{- $message := "" -}}
  {{- with .Items -}}
    {{- range $i, $diagnostic := . -}}
      {{- if $i -}}{{- $message = print $message "\n" -}}{{- end -}}
      {{- $message = print $message (or $diagnostic.Detail (stringValue $diagnostic.Title) (stringValue $diagnostic.Code) "Scanner diagnostic.") -}}
    {{- end -}}
  {{- end -}}
  {{- $_ := set . "Message" $message -}}
{{- end -}}

{{- define "toonAppendMessage" -}}
  {{- if .Message -}}
    {{- $message := .Message -}}
    {{- with index .Envelope .Key -}}{{- $message = print . "\n" $message -}}{{- end -}}
    {{- $_ := set .Envelope .Key $message -}}
  {{- end -}}
{{- end -}}

{{- define "toonDiagnostics" -}}
  {{- $envelope := .State.Envelope -}}
  {{- $scanners := dict -}}
  {{- with .Result.GetTestConfiguration -}}{{- with .ScanConfig -}}
    {{- if .Sca -}}{{- $_ := set $scanners "sca" true -}}{{- end -}}
    {{- if .Secrets -}}{{- $_ := set $scanners "secrets" true -}}{{- end -}}
  {{- end -}}{{- end -}}
  {{- range .Issues -}}
    {{- $findingType := print .GetFindingType -}}
    {{- if or (eq $findingType "sca") (eq $findingType "license") -}}{{- $_ := set $scanners "sca" true -}}{{- end -}}
    {{- if or (eq $findingType "secret") (eq $findingType "secrets") -}}{{- $_ := set $scanners "secrets" true -}}{{- end -}}
  {{- end -}}
  {{- $errors := dict "Items" .Result.GetErrors -}}
  {{- $warnings := dict "Items" .Result.GetWarnings -}}
  {{- template "toonDiagnosticMessage" $errors -}}
  {{- template "toonDiagnosticMessage" $warnings -}}
  {{- $state := .Result.GetExecutionState -}}
  {{- if or (eq $state "pending") (eq $state "started") -}}{{- fail (print "scan is " $state) -}}{{- end -}}
  {{- if and (eq $state "errored") (not $errors.Message) -}}{{- $_ := set $errors "Message" "Scan failed." -}}{{- end -}}
  {{- if not $scanners -}}
    {{- if not $envelope.findings -}}{{- $_ := set $envelope "findings" (array) -}}{{- end -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" "errors" "Message" $errors.Message) -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" "warnings" "Message" $warnings.Message) -}}
  {{- end -}}
  {{- if and $errors.Message (not .Issues) -}}{{- $_ := set .State "Fatal" true -}}{{- end -}}
  {{- range $scanner, $_ := $scanners -}}
    {{- if not (index $envelope $scanner) -}}{{- $_ := set $envelope $scanner (array) -}}{{- end -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" (print $scanner "_error") "Message" $errors.Message) -}}
    {{- $warningKey := print $scanner "_warning" -}}
    {{- if eq $scanner "secrets" -}}{{- $warningKey = "secrets_hint" -}}{{- end -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" $warningKey "Message" $warnings.Message) -}}
  {{- end -}}
{{- end -}}

{{- define "toonDocument" -}}
  {{- $first := true -}}
  {{- range $key, $value := . -}}
    {{- if not $first }}{{ "\n" }}{{ end -}}
    {{- template "toonField" (toonContext $key $value "") -}}
    {{- $first = false -}}
  {{- end -}}
{{- end -}}

{{- /* Callers emit the field's prefix; Indent determines its children's indentation. */ -}}
{{- define "toonField" -}}
  {{- toonKey .Key -}}
  {{- $kind := toonKind .Value -}}
  {{- if eq $kind "object" -}}
    {{- ":" -}}
    {{- $indent := print .Indent "  " -}}
    {{- range $key, $value := .Value -}}
      {{- "\n" }}{{ $indent -}}
      {{- template "toonField" (toonContext $key $value $indent) -}}
    {{- end -}}
  {{- else if eq $kind "array" -}}
    {{- template "toonArray" . -}}
  {{- else -}}
    {{- ": " }}{{ toonPrimitive .Value false -}}
  {{- end -}}
{{- end -}}

{{- define "toonArray" -}}
  {{- if eq (len .Value) 0 -}}
    {{- ": []" -}}
  {{- else -}}
    {{- "[" }}{{ len .Value }}{{ "]" -}}
    {{- $fields := toonTabularFields .Value -}}
    {{- $indent := print .Indent "  " -}}
    {{- if $fields -}}
      {{- "{" }}{{ template "toonColumns" $fields }}{{ "}:" -}}
      {{- range $row := .Value -}}
        {{- "\n" }}{{ $indent -}}
        {{- range $i, $cell := toonTabularCells $row $fields -}}
          {{- if $i }},{{ end -}}
          {{- toonPrimitive $cell true -}}
        {{- end -}}
      {{- end -}}
    {{- else if toonAllPrimitive .Value -}}
      {{- ": " }}{{ template "toonPrimitives" .Value -}}
    {{- else -}}
      {{- ":" -}}
      {{- range $item := .Value -}}
        {{- "\n" }}{{ $indent -}}
        {{- template "toonItem" (toonContext "" $item $indent) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- define "toonColumns" -}}
  {{- range $i, $field := . -}}
    {{- if $i }},{{ end -}}
    {{- toonKey $field.Name -}}
    {{- if $field.Nested -}}
      {{- "{" }}{{ template "toonColumns" $field.Nested }}{{ "}" -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- define "toonPrimitives" -}}
  {{- range $i, $value := . -}}
    {{- if $i }},{{ end -}}
    {{- toonPrimitive $value true -}}
  {{- end -}}
{{- end -}}

{{- define "toonItem" -}}
  {{- "-" -}}
  {{- $kind := toonKind .Value -}}
  {{- $indent := print .Indent "  " -}}
  {{- if eq $kind "object" -}}
    {{- $first := true -}}
    {{- range $key, $value := .Value -}}
      {{- if $first }}{{ " " }}{{ else }}{{ "\n" }}{{ $indent }}{{ end -}}
      {{- template "toonField" (toonContext $key $value $indent) -}}
      {{- $first = false -}}
    {{- end -}}
  {{- else if eq $kind "array" -}}
    {{- if eq (len .Value) 0 -}}
      {{- " []" -}}
    {{- else -}}
      {{- " [" }}{{ len .Value }}{{ "]:" -}}
      {{- if toonAllPrimitive .Value -}}
        {{- " " }}{{ template "toonPrimitives" .Value -}}
      {{- else -}}
        {{- range $item := .Value -}}
          {{- "\n" }}{{ $indent -}}
          {{- template "toonItem" (toonContext "" $item $indent) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- else -}}
    {{- " " }}{{ toonPrimitive .Value false -}}
  {{- end -}}
{{- end -}}
