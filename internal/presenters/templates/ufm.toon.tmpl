{{- define "main" -}}
  {{- $envelope := dict -}}
  {{- $state := dict "Envelope" $envelope "Fatal" false "Successful" (dict) "Paths" 0
                    "Full" (eq (getValueFromConfig "toon") "full") -}}
  {{- /* Prepare every result before writing: a later error must leave the destination untouched. */ -}}
  {{- range $result := .TestResults -}}
    {{- $issues := getIssuesFromTestResultWithContext (getContext) $result -}}
    {{- template "toonDiagnostics" (dict "State" $state "Result" $result "Issues" $issues) -}}
    {{- $mappedIssues := array -}}
    {{- range $issue := reverse (sortAndFilterIssues $issues false) -}}
      {{- $mappedIssues = append $mappedIssues $issue -}}
    {{- end -}}
    {{- if eq (getValueFromConfig "include-ignores") "true" -}}
      {{- range $issue := reverse (sortAndFilterIssues $issues true) -}}
        {{- $mappedIssues = append $mappedIssues $issue -}}
      {{- end -}}
    {{- end -}}
    {{- range $issue := $mappedIssues -}}
      {{- $findingType := print $issue.GetFindingType -}}
      {{- if or (eq $findingType "sca") (eq $findingType "license") -}}
        {{- template "toonSCA" (dict "State" $state "Issue" $issue) -}}
      {{- else if or (eq $findingType "secret") (eq $findingType "secrets") -}}
        {{- range $finding := $issue.GetFindings -}}
          {{- with $finding.Attributes -}}
            {{- template "toonSecrets" (dict "Envelope" $envelope "Issue" $issue "Attributes" .) -}}
          {{- end -}}
        {{- end -}}
      {{- else -}}
        {{- template "toonFinding" (dict "Envelope" $envelope "Issue" $issue) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- template "toonSummaries" $state -}}
  {{- if .TestResults -}}{{- template "toonContextFields" $state -}}{{- end -}}
  {{- template "toonDocument" $envelope -}}
{{- end -}}

{{- define "toonSummaries" -}}
  {{- range $scanner := array "sca" "secrets" -}}
    {{- $rows := or (index $.Envelope $scanner) (array) -}}
    {{- $count := len $rows -}}
    {{- if not (or $count (index $.Successful $scanner)) -}}{{- continue -}}{{- end -}}
    {{- $summary := "0 secrets found" -}}
    {{- if eq $scanner "sca" -}}{{- $summary = "0 vulnerabilities found" -}}{{- end -}}
    {{- if $count -}}
      {{- $counts := dict -}}{{- $fixable := 0 -}}
      {{- range $row := $rows -}}
        {{- $severity := print $row.severity -}}
        {{- $_ := set $counts $severity (add (or (index $counts $severity) 0) 1) -}}
        {{- if eq (print $row.fixable) "yes" -}}{{- $fixable = add $fixable 1 -}}{{- end -}}
      {{- end -}}
      {{- $severities := "" -}}
      {{- range $severity := array "critical" "high" "medium" "low" -}}
        {{- with index $counts $severity -}}
          {{- if $severities -}}{{- $severities = print $severities " " -}}{{- end -}}
          {{- $severities = print $severities . " " $severity -}}
        {{- end -}}
      {{- end -}}
      {{- if eq $scanner "sca" -}}
        {{- $paths := "" -}}
        {{- if gt $.Paths $count -}}{{- $paths = printf " (%d paths)" $.Paths -}}{{- end -}}
        {{- $summary = printf "%d unique vulns%s | %s | %d fixable" $count $paths $severities $fixable -}}
      {{- else -}}
        {{- $summary = printf "%d secrets | %s" $count $severities -}}
      {{- end -}}
    {{- end -}}
    {{- $_ := set $.Envelope (print $scanner "_summary") $summary -}}
  {{- end -}}
{{- end -}}

{{- define "toonContextFields" -}}
  {{- $envelope := .Envelope -}}
  {{- $_ := set $envelope "org" (or (getStringFromConfig "internal_org_slug") (getStringFromConfig "org") "unknown") -}}
  {{- $project := "unknown" -}}
  {{- with getStringFromConfig "targetDirectory" -}}{{- $project = baseName . -}}{{- end -}}
  {{- $_ := set $envelope "project" $project -}}
  {{- with getInteractionID (getContext) -}}{{- $_ := set $envelope "interaction_id" . -}}{{- end -}}
  {{- if and (not .Full) (not .Fatal) -}}{{- $_ := set $envelope "hint" "add --toon=full for all fields" -}}{{- end -}}
  {{- with getErrorTip (getContext) -}}
    {{- $tip := . -}}
    {{- if $envelope.errors -}}{{- $_ := set $envelope "hint" $tip -}}{{- end -}}
    {{- range $scanner := array "sca" "secrets" -}}
      {{- if index $envelope (print $scanner "_error") -}}
        {{- $key := print $scanner "_hint" -}}
        {{- $message := $tip -}}
        {{- with index $envelope $key -}}{{- $message = trimSpace (print . "\n" $tip) -}}{{- end -}}
        {{- $_ := set $envelope $key $message -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- define "toonDiagnosticMessage" -}}
  {{- $message := "" -}}
  {{- with .Items -}}
    {{- range $i, $diagnostic := . -}}
      {{- if $i -}}{{- $message = print $message "\n" -}}{{- end -}}
      {{- $message = print $message (or $diagnostic.Detail (stringValue $diagnostic.Title) (stringValue $diagnostic.Code) "Scanner diagnostic.") -}}
    {{- end -}}
  {{- end -}}
  {{- $_ := set . "Message" $message -}}
{{- end -}}

{{- define "toonAppendMessage" -}}
  {{- if .Message -}}
    {{- $message := .Message -}}
    {{- with index .Envelope .Key -}}{{- $message = print . "\n" $message -}}{{- end -}}
    {{- $_ := set .Envelope .Key $message -}}
  {{- end -}}
{{- end -}}

{{- define "toonDiagnostics" -}}
  {{- $envelope := .State.Envelope -}}
  {{- $scanners := dict -}}
  {{- with .Result.GetTestConfiguration -}}{{- with .ScanConfig -}}
    {{- if .Sca -}}{{- $_ := set $scanners "sca" true -}}{{- end -}}
    {{- if .Secrets -}}{{- $_ := set $scanners "secrets" true -}}{{- end -}}
  {{- end -}}{{- end -}}
  {{- range .Issues -}}
    {{- $findingType := print .GetFindingType -}}
    {{- if or (eq $findingType "sca") (eq $findingType "license") -}}{{- $_ := set $scanners "sca" true -}}{{- end -}}
    {{- if or (eq $findingType "secret") (eq $findingType "secrets") -}}{{- $_ := set $scanners "secrets" true -}}{{- end -}}
  {{- end -}}
  {{- $errors := dict "Items" .Result.GetErrors -}}
  {{- $warnings := dict "Items" .Result.GetWarnings -}}
  {{- template "toonDiagnosticMessage" $errors -}}
  {{- template "toonDiagnosticMessage" $warnings -}}
  {{- $state := .Result.GetExecutionState -}}
  {{- if or (eq $state "pending") (eq $state "started") -}}{{- fail (print "scan is " $state) -}}{{- end -}}
  {{- if and (eq $state "errored") (not $errors.Message) -}}{{- $_ := set $errors "Message" "Scan failed." -}}{{- end -}}
  {{- if not $scanners -}}
    {{- if not $envelope.findings -}}{{- $_ := set $envelope "findings" (array) -}}{{- end -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" "errors" "Message" $errors.Message) -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" "warnings" "Message" $warnings.Message) -}}
  {{- end -}}
  {{- if and $errors.Message (not .Issues) -}}{{- $_ := set .State "Fatal" true -}}{{- end -}}
  {{- range $scanner, $_ := $scanners -}}
    {{- if not $errors.Message -}}{{- $_ := set $.State.Successful $scanner true -}}{{- end -}}
    {{- if not (index $envelope $scanner) -}}{{- $_ := set $envelope $scanner (array) -}}{{- end -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" (print $scanner "_error") "Message" $errors.Message) -}}
    {{- $warningKey := print $scanner "_warning" -}}
    {{- if eq $scanner "secrets" -}}{{- $warningKey = "secrets_hint" -}}{{- end -}}
    {{- template "toonAppendMessage" (dict "Envelope" $envelope "Key" $warningKey "Message" $warnings.Message) -}}
  {{- end -}}
{{- end -}}

{{- define "toonFinding" -}}
  {{- $issue := .Issue -}}
  {{- $row := dict "id" $issue.GetID "finding_type" (print $issue.GetFindingType) "title" $issue.GetTitle "severity" (print $issue.GetEffectiveSeverity) -}}
  {{- $_ := set .Envelope "findings" (append (or .Envelope.findings (array)) $row) -}}
{{- end -}}

{{- define "toonSecrets" -}}
  {{- $attributes := .Attributes -}}
  {{- $rule := or .Issue.GetProblemID $attributes.Title -}}
  {{- $file := "unknown" -}}{{- $line := 0 -}}
  {{- if $attributes.Locations -}}
    {{- $location := getSourceLocation (index $attributes.Locations 0) -}}
    {{- $file = or $location.FilePath "unknown" -}}{{- $line = $location.FromLine -}}
  {{- end -}}
  {{- $row := dict "rule" (or $rule "secret") "severity" (or (toLowerCase (print $attributes.Rating.Severity)) "low") "file" $file "line" (number $line) -}}
  {{- $_ := set .Envelope "secrets" (append (or .Envelope.secrets (array)) $row) -}}
{{- end -}}

{{- define "toonSCA" -}}
  {{- $state := .State -}}
  {{- $issue := .Issue -}}
  {{- $envelope := $state.Envelope -}}
  {{- $problem := false -}}
  {{- $id := "" -}}{{- $severity := "" -}}
  {{- range $source := array "snyk_vuln" "snyk_license" -}}
    {{- range $candidate := $issue.GetProblems -}}
      {{- if eq $candidate.Discriminator $source -}}
        {{- if not $problem -}}{{- $problem = $candidate -}}{{- end -}}
        {{- $fields := jsonStrings $candidate "id" "severity" -}}
        {{- if not $id -}}{{- $id = or $fields.id "" -}}{{- end -}}
        {{- if not $severity -}}{{- $severity = or $fields.severity "" -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if not $problem -}}{{- fail "SCA finding has no supported problem" -}}{{- end -}}
  {{- $findings := $issue.GetFindings -}}
  {{- $_ := set $state "Paths" (add $state.Paths (len $findings)) -}}
  {{- $name := or (getIssueMetadata $issue "component-name") "" -}}
  {{- $versions := sortVersions (or (getIssueMetadata $issue "component-versions") (array)) -}}
  {{- if eq (len $findings) 1 -}}
    {{- $fields := jsonStrings $problem "package_name" "package_version" -}}
    {{- $name = or $fields.package_name $name -}}
    {{- $version := or $fields.package_version "" -}}
    {{- with index $findings 0 -}}{{- with .Attributes -}}
      {{- range $location := .Locations -}}
        {{- if eq $location.Discriminator "package" -}}
          {{- $package := $location.AsPackageLocation -}}
          {{- $name = or $package.Package.Name $name -}}{{- $version = or $package.Package.Version $version -}}
          {{- break -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}{{- end -}}
    {{- if $version -}}{{- $versions = sortVersions (array $version) -}}{{- else -}}{{- $versions = sortVersions (array) -}}{{- end -}}
  {{- end -}}
  {{- $fixable := "no" -}}
  {{- $upgrade := "none" -}}
  {{- range $finding := $findings -}}
    {{- with $finding.Relationships -}}{{- with .Fix -}}{{- with .Data -}}{{- with .Attributes -}}{{- with .Action -}}
      {{- if eq .Discriminator "upgrade_package_advice" -}}
        {{- range .AsUpgradePackageAdvice.UpgradePaths -}}
          {{- if gt (len .DependencyPath) 1 -}}{{- $fixable = "yes" -}}{{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}{{- end -}}{{- end -}}{{- end -}}{{- end -}}
  {{- end -}}
  {{- with index $findings 0 -}}
    {{- with .Relationships -}}{{- with .Fix -}}{{- with .Data -}}{{- with .Attributes -}}{{- with .Action -}}
      {{- if eq .Discriminator "upgrade_package_advice" -}}
        {{- range .AsUpgradePackageAdvice.UpgradePaths -}}
          {{- if gt (len .DependencyPath) 1 -}}
            {{- range slice .DependencyPath 1 -}}
              {{- if and .Name .Version -}}{{- $upgrade = print .Name "@" .Version -}}{{- break -}}{{- end -}}
            {{- end -}}
          {{- end -}}
          {{- if ne $upgrade "none" -}}{{- break -}}{{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}{{- end -}}{{- end -}}{{- end -}}{{- end -}}
  {{- end -}}
  {{- if $state.Full -}}
    {{- range $candidate := $issue.GetProblems -}}
      {{- if eq $candidate.Discriminator "snyk_vuln" -}}
        {{- $_ := jsonNumbers $candidate "cvss_base_score" -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $row := dict "id" $id "severity" $severity "pkg" (print $name "@" (join $versions ",")) "fixable" $fixable -}}
  {{- if $state.Full -}}
    {{- $cvss := "n/a" -}}
    {{- $scores := jsonNumbers $problem "cvss_base_score" -}}
    {{- if $scores -}}{{- $cvss = printf "%.1f" $scores.cvss_base_score -}}{{- end -}}
    {{- $title := $issue.GetTitle -}}
    {{- $runes := runes $title -}}
    {{- if gt (len $runes) 80 -}}{{- $title = printf "%s…(+%d chars)" (runeString (slice $runes 0 80)) (sub (len $runes) 80) -}}{{- end -}}
    {{- $_ := set $row "title" $title -}}{{- $_ := set $row "cvss" $cvss -}}{{- $_ := set $row "upgrade" $upgrade -}}
  {{- end -}}
  {{- $_ := set $envelope "sca" (append (or $envelope.sca (array)) $row) -}}
{{- end -}}

{{- define "toonDocument" -}}
  {{- $first := true -}}
  {{- range $key, $value := . -}}
    {{- if not $first }}{{ "\n" }}{{ end -}}
    {{- template "toonField" (toonContext $key $value "") -}}
    {{- $first = false -}}
  {{- end -}}
{{- end -}}

{{- /* Callers emit the field's prefix; Indent determines its children's indentation. */ -}}
{{- define "toonField" -}}
  {{- toonKey .Key -}}
  {{- $kind := toonKind .Value -}}
  {{- if eq $kind "object" -}}
    {{- ":" -}}
    {{- $indent := print .Indent "  " -}}
    {{- range $key, $value := .Value -}}
      {{- "\n" }}{{ $indent -}}
      {{- template "toonField" (toonContext $key $value $indent) -}}
    {{- end -}}
  {{- else if eq $kind "array" -}}
    {{- template "toonArray" . -}}
  {{- else -}}
    {{- ": " }}{{ toonPrimitive .Value false -}}
  {{- end -}}
{{- end -}}

{{- define "toonArray" -}}
  {{- if eq (len .Value) 0 -}}
    {{- ": []" -}}
  {{- else -}}
    {{- "[" }}{{ len .Value }}{{ "]" -}}
    {{- $fields := toonTabularFields .Value -}}
    {{- $indent := print .Indent "  " -}}
    {{- if $fields -}}
      {{- "{" }}{{ template "toonColumns" $fields }}{{ "}:" -}}
      {{- range $row := .Value -}}
        {{- "\n" }}{{ $indent -}}
        {{- range $i, $cell := toonTabularCells $row $fields -}}
          {{- if $i }},{{ end -}}
          {{- toonPrimitive $cell true -}}
        {{- end -}}
      {{- end -}}
    {{- else if toonAllPrimitive .Value -}}
      {{- ": " }}{{ template "toonPrimitives" .Value -}}
    {{- else -}}
      {{- ":" -}}
      {{- range $item := .Value -}}
        {{- "\n" }}{{ $indent -}}
        {{- template "toonItem" (toonContext "" $item $indent) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- define "toonColumns" -}}
  {{- range $i, $field := . -}}
    {{- if $i }},{{ end -}}
    {{- toonKey $field.Name -}}
    {{- if $field.Nested -}}
      {{- "{" }}{{ template "toonColumns" $field.Nested }}{{ "}" -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- define "toonPrimitives" -}}
  {{- range $i, $value := . -}}
    {{- if $i }},{{ end -}}
    {{- toonPrimitive $value true -}}
  {{- end -}}
{{- end -}}

{{- define "toonItem" -}}
  {{- "-" -}}
  {{- $kind := toonKind .Value -}}
  {{- $indent := print .Indent "  " -}}
  {{- if eq $kind "object" -}}
    {{- $first := true -}}
    {{- range $key, $value := .Value -}}
      {{- if $first }}{{ " " }}{{ else }}{{ "\n" }}{{ $indent }}{{ end -}}
      {{- template "toonField" (toonContext $key $value $indent) -}}
      {{- $first = false -}}
    {{- end -}}
  {{- else if eq $kind "array" -}}
    {{- if eq (len .Value) 0 -}}
      {{- " []" -}}
    {{- else -}}
      {{- " [" }}{{ len .Value }}{{ "]:" -}}
      {{- if toonAllPrimitive .Value -}}
        {{- " " }}{{ template "toonPrimitives" .Value -}}
      {{- else -}}
        {{- range $item := .Value -}}
          {{- "\n" }}{{ $indent -}}
          {{- template "toonItem" (toonContext "" $item $indent) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- else -}}
    {{- " " }}{{ toonPrimitive .Value false -}}
  {{- end -}}
{{- end -}}
